# omni-server configuration. Copy to `.env` and adjust. All keys are optional;
# defaults are shown. The OMNIPARSER_* aliases exist for back-compat.

# --- Mode ---
# 1 = real GPU inference (default). 0 = canned skeleton (no torch/GPU; for CI
# and wire-contract smoke tests).
OMNI_REAL_MODEL=1
# Pay lazy OCR/model init at startup with one warmup parse (recommended).
OMNI_WARMUP=1

# --- Serving ---
OMNI_HOST=0.0.0.0
OMNI_PORT=8001
# When set, /parse requires `Authorization: Bearer <token>`. Leave blank on a
# trusted LAN; set a long random value when the port is reachable beyond it.
# The YouTube client must send the SAME value (its OMNIPARSER_AUTH_TOKEN).
# OMNIPARSER_AUTH_TOKEN is accepted here as an alias, so one shared value works.
OMNI_AUTH_TOKEN=

# --- Request guards ---
OMNI_MAX_IMAGE_BYTES=25165824     # 24 MiB
OMNI_MAX_IMAGE_MP=20.0            # reject frames above ~20 megapixels

# --- Paths (defaults relative to repo root) ---
# OMNI_WEIGHTS_DIR=./weights
# OMNI_VENDOR_DIR=./vendor/OmniParser

# --- Vendor pin (used by scripts/setup_vendor.py) ---
# OMNI_VENDOR_REPO=https://github.com/microsoft/OmniParser
# OMNI_VENDOR_REF=b0d5c9f

# --- Inference tuning (MSFT gradio-demo defaults) ---
# OMNI_BOX_THRESHOLD=0.05
# OMNI_IOU_THRESHOLD=0.1
# OMNI_IMGSZ_MAX=1280
# OMNI_CAPTION_PROMPT=<DETAILED_CAPTION>
# OMNI_USE_PADDLEOCR=1
# OMNI_OCR_TEXT_THRESHOLD=0.7
# OMNI_BATCH_SIZE=64
# Florence-2 captioning is the biggest per-frame cost. Set 0 for a much faster,
# lower-VRAM parse (OCR text + generic icon types, no rich captions); the caption
# model is then not loaded at all.
# OMNI_USE_LOCAL_SEMANTICS=1

# --- HuggingFace cache (persist the Florence-2 processor across restarts) ---
# HF_HOME=/var/cache/huggingface
